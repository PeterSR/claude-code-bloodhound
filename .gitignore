# Local scratch — never tracked
.agent-workspace/

# Go build artifacts
/bloodhound
/bloodhound.exe
/dist/
/vendor/

# Frontend
/web/node_modules/
/web/.vite/
/web/*.tsbuildinfo

# Frontend build output: track only the .gitkeep so //go:embed works on a
# fresh checkout. Real build artifacts are local-only.
/web/dist/*
!/web/dist/.gitkeep

